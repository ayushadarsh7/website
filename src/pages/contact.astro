---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';
---

<Layout title="Contact - Ayush Adarsh">
  <Header />
  <main class="flex-1 max-w-4xl mx-auto px-6 py-16">
    <h1 class="text-3xl md:text-4xl font-black text-warm-900 dark:text-warm-50 mb-4">Contact</h1>
    <p class="text-warm-500 dark:text-warm-400 mb-12">Feel free to reach out.</p>

    <div class="max-w-lg">
      <div class="space-y-5">
        <a
          href="mailto:ayushadarsh2019@gmail.com"
          class="flex items-center gap-4 p-4 bg-white dark:bg-warm-900 rounded-xl border border-warm-100 dark:border-warm-800 hover:border-accent-300 dark:hover:border-accent-700 transition-all group"
        >
          <div class="w-10 h-10 bg-accent-100 dark:bg-accent-950 rounded-lg flex items-center justify-center shrink-0">
            <svg class="w-5 h-5 text-accent-600 dark:text-accent-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 4.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
            </svg>
          </div>
          <div>
            <p class="font-semibold text-warm-900 dark:text-warm-50 group-hover:text-accent-600 dark:group-hover:text-accent-400 transition-colors">Email</p>
            <p class="text-sm text-warm-500 dark:text-warm-400">ayushadarsh2019@gmail.com</p>
          </div>
        </a>

        <a
          href="https://github.com/ayushadarsh7"
          target="_blank"
          rel="noopener noreferrer"
          class="flex items-center gap-4 p-4 bg-white dark:bg-warm-900 rounded-xl border border-warm-100 dark:border-warm-800 hover:border-accent-300 dark:hover:border-accent-700 transition-all group"
        >
          <div class="w-10 h-10 bg-warm-100 dark:bg-warm-800 rounded-lg flex items-center justify-center shrink-0">
            <svg class="w-5 h-5 text-warm-700 dark:text-warm-300" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2C6.48 2 2 6.58 2 12.26c0 4.5 2.87 8.32 6.84 9.67.5.09.68-.22.68-.48 0-.24-.01-.87-.01-1.7-2.78.62-3.37-1.36-3.37-1.36-.45-1.18-1.1-1.5-1.1-1.5-.9-.63.07-.62.07-.62 1 .07 1.53 1.05 1.53 1.05.89 1.56 2.34 1.11 2.91.85.09-.66.35-1.11.63-1.37-2.22-.26-4.56-1.14-4.56-5.07 0-1.12.39-2.03 1.03-2.75-.1-.26-.45-1.3.1-2.7 0 0 .84-.28 2.75 1.05A9.38 9.38 0 0112 6.84c.85.004 1.71.12 2.51.35 1.91-1.33 2.75-1.05 2.75-1.05.55 1.4.2 2.44.1 2.7.64.72 1.03 1.63 1.03 2.75 0 3.94-2.34 4.81-4.57 5.07.36.32.68.94.68 1.9 0 1.37-.01 2.47-.01 2.8 0 .27.18.58.69.48A10.01 10.01 0 0022 12.26C22 6.58 17.52 2 12 2z"/></svg>
          </div>
          <div>
            <p class="font-semibold text-warm-900 dark:text-warm-50 group-hover:text-accent-600 dark:group-hover:text-accent-400 transition-colors">GitHub</p>
            <p class="text-sm text-warm-500 dark:text-warm-400">ayushadarsh7</p>
          </div>
        </a>

        <a
          href="https://www.linkedin.com/in/ayushadarsh002"
          target="_blank"
          rel="noopener noreferrer"
          class="flex items-center gap-4 p-4 bg-white dark:bg-warm-900 rounded-xl border border-warm-100 dark:border-warm-800 hover:border-accent-300 dark:hover:border-accent-700 transition-all group"
        >
          <div class="w-10 h-10 bg-blue-100 dark:bg-blue-950 rounded-lg flex items-center justify-center shrink-0">
            <svg class="w-5 h-5 text-blue-600 dark:text-blue-400" fill="currentColor" viewBox="0 0 24 24"><path d="M19 0h-14c-2.76 0-5 2.24-5 5v14c0 2.76 2.24 5 5 5h14c2.76 0 5-2.24 5-5v-14c0-2.76-2.24-5-5-5zm-11 19h-3v-10h3v10zm-1.5-11.28c-.97 0-1.75-.79-1.75-1.75s.78-1.75 1.75-1.75 1.75.79 1.75 1.75-.78 1.75-1.75 1.75zm15.5 11.28h-3v-5.6c0-1.34-.03-3.07-1.87-3.07-1.87 0-2.16 1.46-2.16 2.97v5.7h-3v-10h2.88v1.36h.04c.4-.75 1.38-1.54 2.84-1.54 3.04 0 3.6 2 3.6 4.59v5.59z"/></svg>
          </div>
          <div>
            <p class="font-semibold text-warm-900 dark:text-warm-50 group-hover:text-accent-600 dark:group-hover:text-accent-400 transition-colors">LinkedIn</p>
            <p class="text-sm text-warm-500 dark:text-warm-400">ayushadarsh002</p>
          </div>
        </a>

        <a
          href="https://medium.com/@ayushadarsh2019"
          target="_blank"
          rel="noopener noreferrer"
          class="flex items-center gap-4 p-4 bg-white dark:bg-warm-900 rounded-xl border border-warm-100 dark:border-warm-800 hover:border-accent-300 dark:hover:border-accent-700 transition-all group"
        >
          <div class="w-10 h-10 bg-warm-100 dark:bg-warm-800 rounded-lg flex items-center justify-center shrink-0">
            <svg class="w-5 h-5 text-warm-700 dark:text-warm-300" fill="currentColor" viewBox="0 0 24 24"><path d="M13.54 12a6.8 6.8 0 01-6.77 6.82A6.8 6.8 0 010 12a6.8 6.8 0 016.77-6.82A6.8 6.8 0 0113.54 12zm7.42 0c0 3.54-1.51 6.42-3.38 6.42-1.87 0-3.39-2.88-3.39-6.42s1.52-6.42 3.39-6.42 3.38 2.88 3.38 6.42zm2.04 0c0 3.17-.53 5.75-1.19 5.75-.66 0-1.19-2.58-1.19-5.75s.53-5.75 1.19-5.75c.66 0 1.19 2.58 1.19 5.75z"/></svg>
          </div>
          <div>
            <p class="font-semibold text-warm-900 dark:text-warm-50 group-hover:text-accent-600 dark:group-hover:text-accent-400 transition-colors">Medium</p>
            <p class="text-sm text-warm-500 dark:text-warm-400">@ayushadarsh2019</p>
          </div>
        </a>
      </div>
    </div>
  </main>
  <Footer />
</Layout>
